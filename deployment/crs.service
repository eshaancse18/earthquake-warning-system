[Unit]
Description=Earthquake Warning System - Central Receiving Server
Documentation=https://localhost

After=network-online.target
After=docker.service
After=postgresql.service

Wants=network-online.target

StartLimitIntervalSec=0

[Service]

Type=simple

User=earthquake
Group=earthquake

WorkingDirectory=/opt/earthquake-warning-system/crs

Environment=PYTHONUNBUFFERED=1

Environment=DATABASE_URL=postgresql+psycopg2://earthquake:earthquake_password@localhost:5432/earthquake_db

Environment=MQTT_BROKER_IP=127.0.0.1
Environment=MQTT_BROKER_PORT=1883

ExecStart=/opt/earthquake-warning-system/venv/bin/python \
/opt/earthquake-warning-system/crs/main.py

Restart=always
RestartSec=5

TimeoutStartSec=60
TimeoutStopSec=30

KillMode=mixed

StandardOutput=append:/var/log/earthquake/crs_stdout.log
StandardError=append:/var/log/earthquake/crs_stderr.log

NoNewPrivileges=true

PrivateTmp=true

ProtectHome=true

LimitNOFILE=65535

[Install]

WantedBy=multi-user.target