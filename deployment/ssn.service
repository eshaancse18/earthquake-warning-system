[Unit]
Description=Earthquake Warning System - SSN Station Node
Documentation=https://localhost
After=network-online.target
After=time-sync.target
After=multi-user.target

Wants=network-online.target

StartLimitIntervalSec=0

[Service]

Type=simple

User=pi
Group=pi

WorkingDirectory=/opt/earthquake-warning-system/ssn

Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/earthquake-warning-system/venv/bin/python \
/opt/earthquake-warning-system/ssn/main.py

Restart=always
RestartSec=5

TimeoutStartSec=30
TimeoutStopSec=30

KillMode=mixed

StandardOutput=append:/var/log/earthquake/ssn_stdout.log
StandardError=append:/var/log/earthquake/ssn_stderr.log

NoNewPrivileges=true

PrivateTmp=true

ProtectSystem=full

ProtectHome=true

LimitNOFILE=65535

[Install]

WantedBy=multi-user.target